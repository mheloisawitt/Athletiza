graph G {
  graph [rankdir=LR, splines=true, nodesep=0.8, ranksep=1.3, fontname="Helvetica", fontsize=16, labelloc=t, label=<<B>Colaboração 4 - Mudar situação de uma demanda</B><BR/> >];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=13, margin="0.25,0.12"];
  edge [fontname="Helvetica", fontsize=11];
  u [shape=plaintext, label=<<FONT POINT-SIZE="26">&#9786;</FONT><BR/>Usuário>];
  v [shape=box, style="", label=<<U>:PainelConsultaDemandas</U>>];
  c [shape=box, style="", label=<<U>:DemandaController</U>>];
  se [shape=box, style="", label=<<U>:Sessao</U>>];
  dm [shape=box, style="", label=<<U>demanda:Demanda</U>>];
  d [shape=box, style="", label=<<U>:DemandaDAO</U>>];
  m [shape=box, style="", label=<<U>:Mensagens</U>>];
  u -- v [label=<&#8594; 1: mudarSituacao()<BR ALIGN="LEFT"/>>];
  v -- c [label=<&#8594; 1.1: podeMudarSituacao(demanda)<BR ALIGN="LEFT"/>&#8594; 1.2: podeCancelar(demanda)<BR ALIGN="LEFT"/>&#8594; 1.3: mudarSituacao(demanda, nova)<BR ALIGN="LEFT"/>>];
  c -- se [label=<&#8594; 1.1.1: getAcesso()<BR ALIGN="LEFT"/>&#8594; 1.1.2: getUsuarioLogado()<BR ALIGN="LEFT"/>>];
  c -- dm [label=<&#8594; 1.1.3: isResponsavel(membro)<BR ALIGN="LEFT"/>&#8594; 1.3.2: setSituacao(nova)<BR ALIGN="LEFT"/>>];
  c -- d [label=<&#8594; 1.3.1: atualizarSituacao(id, nova)<BR ALIGN="LEFT"/>>];
  v -- m [label=<&#8594; 1.4: sucesso(painel, "Situação alterada")<BR ALIGN="LEFT"/>>];
}