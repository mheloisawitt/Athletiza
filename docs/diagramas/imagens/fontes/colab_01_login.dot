graph G {
  graph [rankdir=LR, splines=true, nodesep=0.8, ranksep=1.3, fontname="Helvetica", fontsize=16, labelloc=t, label=<<B>Colaboração 1 - Login</B><BR/> >];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=13, margin="0.25,0.12"];
  edge [fontname="Helvetica", fontsize=11];
  u [shape=plaintext, label=<<FONT POINT-SIZE="26">&#9786;</FONT><BR/>Usuário>];
  v [shape=box, style="", label=<<U>:TelaLogin</U>>];
  c [shape=box, style="", label=<<U>:LoginController</U>>];
  val [shape=box, style="", label=<<U>:Validador</U>>];
  d [shape=box, style="", label=<<U>:UsuarioDAO</U>>];
  s [shape=box, style="", label=<<U>:Senha</U>>];
  a [shape=box, style="", label=<<U>:AcessoController</U>>];
  se [shape=box, style="", label=<<U>:Sessao</U>>];
  p [shape=box, style="", label=<<U>:TelaPrincipal</U>>];
  u -- v [label=<&#8594; 1: entrar(login, senha)<BR ALIGN="LEFT"/>>];
  v -- c [label=<&#8594; 1.1: autenticar(login, senha)<BR ALIGN="LEFT"/>>];
  c -- val [label=<&#8594; 1.1.1: obrigatorio(...).validar()<BR ALIGN="LEFT"/>>];
  c -- d [label=<&#8594; 1.1.2: buscarPorLogin(login)<BR ALIGN="LEFT"/>>];
  c -- s [label=<&#8594; 1.1.3: conferir(senha, hash)<BR ALIGN="LEFT"/>>];
  c -- a [label=<&#8594; 1.1.4: calcular(usuario)<BR ALIGN="LEFT"/>>];
  c -- se [label=<&#8594; 1.1.5: iniciar(usuario, acesso)<BR ALIGN="LEFT"/>>];
  v -- p [label=<&#8594; 1.2: new TelaPrincipal(usuario)<BR ALIGN="LEFT"/>>];
}