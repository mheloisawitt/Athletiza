graph G {
  graph [rankdir=LR, splines=true, nodesep=0.8, ranksep=1.3, fontname="Helvetica", fontsize=16, labelloc=t, label=<<B>Colaboração 3 - Cadastrar modalidade (JPA)</B><BR/> >];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=13, margin="0.25,0.12"];
  edge [fontname="Helvetica", fontsize=11];
  u [shape=plaintext, label=<<FONT POINT-SIZE="26">&#9786;</FONT><BR/>Usuário>];
  v [shape=box, style="", label=<<U>:PainelCadastroModalidade</U>>];
  c [shape=box, style="", label=<<U>:ModalidadeController</U>>];
  d [shape=box, style="", label=<<U>:ModalidadeDAO</U>>];
  j [shape=box, style="", label=<<U>:JPAUtil</U>>];
  em [shape=box, style="", label=<<U>:EntityManager</U>>];
  m [shape=box, style="", label=<<U>:Mensagens</U>>];
  u -- v [label=<&#8594; 1: salvar()<BR ALIGN="LEFT"/>>];
  v -- c [label=<&#8594; 1.1: salvar(modalidade)<BR ALIGN="LEFT"/>>];
  c -- d [label=<&#8594; 1.1.1: listarTodos()<BR ALIGN="LEFT"/>&#8594; 1.1.2: inserir(modalidade)<BR ALIGN="LEFT"/>>];
  d -- j [label=<&#8594; 1.1.2.1: getEntityManager()<BR ALIGN="LEFT"/>>];
  d -- em [label=<&#8594; 1.1.2.2: getTransaction().begin()<BR ALIGN="LEFT"/>&#8594; 1.1.2.3: persist(modalidade)<BR ALIGN="LEFT"/>&#8594; 1.1.2.4: getTransaction().commit()<BR ALIGN="LEFT"/>&#8594; 1.1.2.5: close()<BR ALIGN="LEFT"/>>];
  v -- m [label=<&#8594; 1.2: sucesso(painel, "Modalidade salva")<BR ALIGN="LEFT"/>>];
}